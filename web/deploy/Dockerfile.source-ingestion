# Build from the repository root with the paired dockerignore file.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

ENV NODE_ENV=production \
    BIPLAN_PG_STATEMENT_TIMEOUT_MS=30000
WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN node -e "const fs=require('fs');const p=require('./package.json');p.dependencies={pg:p.dependencies.pg,'@google-cloud/storage':p.dependencies['@google-cloud/storage']};p.devDependencies={};fs.writeFileSync('package.json',JSON.stringify(p))" \
    && npm ci --omit=dev --ignore-scripts && npm cache clean --force

WORKDIR /app/collector
COPY collector/package.json collector/package-lock.json ./
RUN node -e "const fs=require('fs');const p=require('./package.json');p.dependencies={cheerio:p.dependencies.cheerio};fs.writeFileSync('package.json',JSON.stringify(p))" \
    && npm ci --omit=dev --ignore-scripts && npm cache clean --force

WORKDIR /app/web
COPY web/scripts/run-postgres-source-ingestion.mjs ./scripts/
COPY web/lib/gcs-artifact-loader.node.mjs web/lib/postgres-client.node.ts web/lib/sql-literal.ts \
     web/lib/source.ts web/lib/search.ts web/lib/types.ts web/lib/event-format.ts web/lib/event-timing.ts web/lib/intent.ts ./lib/
COPY contracts/ /app/contracts/
COPY collector/adapters.mjs collector/biletinial.mjs collector/bubilet.mjs collector/flight.mjs /app/collector/
COPY collector/preparation/batch-store.mjs collector/preparation/canonical-adapter.mjs \
     collector/preparation/canonical-store.mjs collector/preparation/collector-page-receipt.mjs \
     collector/preparation/page-batch-source.mjs collector/preparation/page-batch-source-store.mjs \
     collector/preparation/source-adapter.mjs /app/collector/preparation/

USER node
ENTRYPOINT ["node", "--experimental-strip-types", "scripts/run-postgres-source-ingestion.mjs"]
