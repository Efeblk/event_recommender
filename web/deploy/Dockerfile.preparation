# Build from the repository root: docker build -f web/deploy/Dockerfile.preparation .
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

ENV NODE_ENV=production \
    BIPLAN_PG_STATEMENT_TIMEOUT_MS=30000
WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN node -e "const fs=require('fs');const p=require('./package.json');p.dependencies={pg:p.dependencies.pg};p.devDependencies={};fs.writeFileSync('package.json',JSON.stringify(p))"
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY web/scripts/run-postgres-preparation.mjs ./scripts/run-postgres-preparation.mjs
COPY web/scripts/postgres-publication-client.mjs ./scripts/postgres-publication-client.mjs
COPY web/lib/postgres-client.node.ts web/lib/sql-literal.ts ./lib/
COPY collector/preparation/batch-store.mjs collector/preparation/batch-worker.mjs collector/preparation/canonical-worker.mjs /app/collector/preparation/

USER node
ENTRYPOINT ["node", "--experimental-strip-types", "scripts/run-postgres-preparation.mjs"]
