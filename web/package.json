{
  "name": "biplan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:node": "node scripts/build-node.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:node": "node dist-node/server.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:quality": "node scripts/benchmark-response-quality.mjs",
    "test:smoke": "node --experimental-strip-types scripts/smoke.mjs && npm run test:voyage-workerd",
    "test:voyage-workerd": "node scripts/voyage-workerd-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "data:refresh": "node --experimental-strip-types scripts/refresh.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "local:start": "node scripts/local-start.mjs",
    "local:refresh": "node scripts/local-refresh.mjs",
    "embeddings:index": "node scripts/index-embeddings.mjs",
    "deploy:config": "node scripts/deploy-config.mjs",
    "deploy:prepare": "node scripts/deploy.mjs prepare",
    "deploy:dry-run": "node scripts/deploy.mjs dry-run",
    "test:deploy-config": "node --test deploy/*.test.mjs",
    "deploy:run": "node scripts/deploy.mjs deploy",
    "test:browser": "playwright test",
    "test:smoke:node": "node scripts/smoke-node.mjs",
    "test:deploy:gcp": "node scripts/check-gcp-deploy-config.mjs",
    "test:input-intent": "node --experimental-strip-types scripts/check-input-intent.mjs",
    "graph:start": "node experiments/graph/local.mjs",
    "graph:load": "node --experimental-strip-types experiments/graph/load.ts",
    "graph:demo": "node --experimental-strip-types experiments/graph/server.ts",
    "graph:benchmark": "node --experimental-strip-types experiments/graph/benchmark.ts",
    "catalog:start": "node ../collector/preparation/local.mjs",
    "catalog:import": "node --experimental-strip-types ../collector/preparation/import.ts",
    "catalog:verify": "node --experimental-strip-types ../collector/preparation/verify.mjs",
    "catalog:verify:offers": "node ../collector/preparation/verify-offers.mjs",
    "catalog:work": "node ../collector/preparation/run-worker.mjs",
    "catalog:verify:worker": "node ../collector/preparation/verify-worker.mjs",
    "catalog:refresh": "node ../collector/preparation/run-refresh.mjs",
    "catalog:verify:refresh": "node ../collector/preparation/verify-refresh.mjs",
    "catalog:source": "node --experimental-strip-types ../collector/preparation/run-source.mjs",
    "catalog:search": "node --experimental-strip-types ../collector/preparation/run-search.mjs",
    "catalog:verify:flow": "node --experimental-strip-types ../collector/preparation/verify-source-search.mjs",
    "catalog:verify:read": "node --experimental-strip-types ../collector/preparation/verify-publication-read.mjs",
    "catalog:canonical:source": "node --experimental-strip-types ../collector/preparation/run-canonical-source.mjs",
    "catalog:canonical:work": "node ../collector/preparation/run-canonical.mjs",
    "catalog:verify:canonical": "node ../collector/preparation/verify-canonical.mjs",
    "catalog:verify:runtime": "node --experimental-strip-types ../collector/preparation/verify-postgres-runtime.mjs",
    "catalog:verify:roles": "node --experimental-strip-types ../collector/preparation/verify-roles.mjs",
    "catalog:verify:managed-admin": "node ../collector/preparation/verify-managed-admin.mjs",
    "catalog:verify:migration-replay": "node ../collector/preparation/verify-migration-replay.mjs",
    "catalog:verify:bulk-publication": "node --experimental-strip-types ../collector/preparation/verify-bulk-publication.mjs",
    "catalog:batch:source": "node --experimental-strip-types ../collector/preparation/run-batch-source.mjs",
    "catalog:page-batch:source": "node --experimental-strip-types ../collector/preparation/run-page-batch-source.mjs",
    "catalog:source:upload": "node scripts/upload-postgres-source.mjs",
    "deploy:postgres:job:render": "node scripts/render-postgres-job.mjs",
    "catalog:verify:page-receipts": "node --experimental-strip-types ../collector/preparation/verify-page-receipts.mjs",
    "catalog:verify:page-source": "node --experimental-strip-types ../collector/preparation/verify-page-source.mjs",
    "catalog:verify:offer-projections": "node --experimental-strip-types ../collector/preparation/verify-offer-projections.mjs",
    "catalog:verify:serving-artifacts": "node --experimental-strip-types ../collector/preparation/verify-serving-artifacts.mjs",
    "catalog:verify:batch-guards": "node --experimental-strip-types ../collector/preparation/verify-batch-guards.mjs",
    "catalog:batch:work": "node --experimental-strip-types ../collector/preparation/run-batch.mjs",
    "catalog:verify:batch": "node --experimental-strip-types ../collector/preparation/verify-batch.mjs",
    "test:smoke:postgres": "node scripts/smoke-postgres-node.mjs",
    "test:deploy:postgres-plan": "node scripts/check-gcp-postgres-plan.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@google-cloud/firestore": "9.2.0",
    "@google-cloud/storage": "8.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/workers-types": "5.20260926.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.144.0"
  },
  "type": "module",
  "imports": {
    "#biplan/store": "./lib/store.cloudflare.ts"
  }
}
