# Keyless preview: leave all API keys empty. All settings are SERVER-SIDE.
# Generic provider: set these three together. URL is the API root, not /chat/completions.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Blank chooses Responses for api.openai.com/v1, chat-completions for other roots.
AI_PROTOCOL=
# json_schema preferred; explicitly use json_object for models without schema support.
AI_OUTPUT_FORMAT=json_schema
AI_MAX_OUTPUT_TOKENS=1800
# Chat Completions only; some reasoning models require max_completion_tokens.
AI_TOKEN_PARAMETER=max_tokens

# Optional INDEPENDENT embedding provider. Chat credentials are never reused here.
# Custom embeddings require key, base URL, model and the model's actual output dimension.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=512
# Blank: true for OpenAI, false for other endpoints. Use true if dimension reduction is supported.
EMBEDDING_SEND_DIMENSIONS=
# false disables even legacy OpenAI embeddings. Does not disable AI chat.
EMBEDDING_ENABLED=true

# Backward-compatible direct OpenAI setup. Ignored for chat if AI_API_KEY/AI_BASE_URL is set.
# With no custom chat/embedding endpoint, also supplies optional OpenAI embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# At most this many AI recommendation requests per UTC day, across all users.
AI_DAILY_LIMIT=100
# Random server-side secret for POST /api/admin/sync. Never prefix secrets with VITE_ or NEXT_PUBLIC_.
SYNC_TOKEN=
# Trusted public origin; used only for social preview metadata.
SITE_URL=http://localhost:3001
