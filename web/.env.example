# Active recommendation ranking. All settings are SERVER-SIDE.
# Leave TYPESAFE_API_KEY empty for the honest deterministic fallback.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Optional semantic recommendation ranking and embedding index provider.
# The API key stays server-side. Without it, semantic queries are disabled.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large
VOYAGE_DIMENSIONS=1024
# Shared cap for recommendation requests whenever Jev or Voyage is configured (1-10000 per UTC day).
AI_DAILY_LIMIT=100

# Legacy provider configuration is retained for opt-in admin/backward tooling.
# It does not enable or participate in the public recommendation route.
# Generic provider: set these three together. URL is the API root, not /chat/completions.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Blank chooses Responses for api.openai.com/v1, chat-completions for other roots.
AI_PROTOCOL=
# json_schema preferred; explicitly use json_object for models without schema support.
AI_OUTPUT_FORMAT=json_schema
AI_MAX_OUTPUT_TOKENS=1800
# Chat Completions only; some reasoning models require max_completion_tokens.
AI_TOKEN_PARAMETER=max_tokens

# Optional INDEPENDENT embedding provider. Chat credentials are never reused here.
# Custom embeddings require key, base URL, model and the model's actual output dimension.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=512
# Blank: true for OpenAI, false for other endpoints. Use true if dimension reduction is supported.
EMBEDDING_SEND_DIMENSIONS=
# Only explicitly enable for legacy admin embedding work; recommendations do not use it.
EMBEDDING_ENABLED=false

# Backward-compatible direct OpenAI setup. Ignored for chat if AI_API_KEY/AI_BASE_URL is set.
# With no custom chat/embedding endpoint, also supplies optional OpenAI embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Random server-side secret for admin sync, import and collection checkpoints.
# Never prefix secrets with VITE_ or NEXT_PUBLIC_.
SYNC_TOKEN=
# Trusted public origin; used only for social preview metadata.
SITE_URL=http://localhost:3001
# Optional public HTTPS donation page. Blank keeps the support section coming soon.
DONATION_URL=
